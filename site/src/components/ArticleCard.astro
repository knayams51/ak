---
import TaxonomyBadge from './TaxonomyBadge.astro';

const { article } = Astro.props;
const formattedDate = new Date(article.published_at).toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="card" style="display: flex; flex-direction: column; height: 100%;">
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
    <TaxonomyBadge topic={article.topic} size="small" />
    <span style="font-size: 0.8rem; color: var(--text-muted);">
      {formattedDate} • {article.reading_time_minutes} min read
    </span>
  </div>

  <h3 style="font-size: 1.25rem; line-height: 1.4; margin-bottom: 0.65rem;">
    <a href={`/articles/${article.slug}`} style="color: inherit; text-decoration: none;">
      {article.title}
    </a>
  </h3>

  <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem; flex-grow: 1;">
    {article.summary}
  </p>

  <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border-light); padding-top: 0.75rem; margin-top: auto;">
    <span style="font-weight: 600;">By {article.byline} ({article.dateline})</span>
    <a href={`/articles/${article.slug}`} style="font-weight: 600; color: var(--accent-color); text-decoration: none;">
      Read dispatch →
    </a>
  </div>
</article>
