---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Arun Kumar Living Journalistic Archive"
  description="The requested dispatch or archival record could not be found. Explore the living chronological archive or search the collection."
>
  <div class="container not-found-wrapper">
    <div class="not-found-card">
      <div class="not-found-badge">
        <span class="badge-dot"></span>
        <span class="badge-code">404</span>
        <span class="badge-sep">•</span>
        <span class="badge-text">Archival Record Not Located</span>
      </div>

      <h1 class="not-found-headline">Dispatch Not Found (404)</h1>

      <p class="not-found-lead">
        The journalistic dispatch, investigative dossier, or archival record you requested could not be found at this address.
        It may have been reorganized under an updated reporting beat, relocated within the living chronology, or the link may be mistyped.
      </p>

      {/* Direct Search Bar Redirect */}
      <div class="not-found-search-section">
        <p class="search-section-label">Search the living journalistic archive:</p>
        <form action="/search" method="GET" class="search-form" id="searchRedirectForm">
          <div class="search-input-group">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              name="q"
              id="searchQueryInput"
              placeholder="Search by keywords, BPSC, Patna High Court, Nitish Kumar, university reforms..."
              aria-label="Search dispatches"
              autocomplete="off"
            />
            <button type="submit" class="btn btn-primary search-submit-btn">
              Search Archive
            </button>
          </div>
        </form>
      </div>

      {/* Suggested Navigation Options */}
      <div class="navigation-options">
        <h2 class="navigation-heading">Suggested Archival Destinations</h2>
        <div class="nav-cards-grid">
          <a href="/archive" class="nav-card">
            <div class="nav-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
            </div>
            <div class="nav-card-body">
              <h3 class="nav-card-title">Living Chronological Archive</h3>
              <p class="nav-card-desc">Browse complete year-by-year dispatches and verified print broadsheet clippings</p>
            </div>
            <span class="nav-card-arrow">→</span>
          </a>

          <a href="/topics" class="nav-card">
            <div class="nav-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </div>
            <div class="nav-card-body">
              <h3 class="nav-card-title">Bihar Reporting Beats</h3>
              <p class="nav-card-desc">Explore taxonomy beats across Governance, Education, Judiciary, and Vigilance</p>
            </div>
            <span class="nav-card-arrow">→</span>
          </a>

          <a href="/" class="nav-card">
            <div class="nav-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <div class="nav-card-body">
              <h3 class="nav-card-title">Front Page Homepage</h3>
              <p class="nav-card-desc">Return to the digital broadsheet front page, featured investigations, and bio</p>
            </div>
            <span class="nav-card-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('searchRedirectForm') as HTMLFormElement;
    const input = document.getElementById('searchQueryInput') as HTMLInputElement;

    form?.addEventListener('submit', (e) => {
      const q = input?.value?.trim();
      if (!q) {
        e.preventDefault();
        window.location.href = '/search';
      }
    });
  </script>
</BaseLayout>

<style>
.not-found-wrapper {
  max-width: 860px;
  padding-top: 4rem;
  padding-bottom: 5rem;
}

.not-found-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 3rem 2.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
}

@media (max-width: 640px) {
  .not-found-wrapper {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .not-found-card {
    padding: 2rem 1.25rem;
  }
}

.not-found-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: rgba(185, 28, 28, 0.1);
  border: 1px solid rgba(185, 28, 28, 0.25);
  color: var(--accent-color);
  padding: 0.35rem 0.85rem;
  border-radius: 9999px;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 1.5rem;
}

:global([data-theme="dark"]) .not-found-badge {
  background-color: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.35);
}

.badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: currentColor;
}

.badge-code {
  font-family: var(--font-mono);
  font-weight: 800;
}

.badge-sep {
  opacity: 0.6;
}

.not-found-headline {
  font-family: var(--font-serif);
  font-size: 2.5rem;
  line-height: 1.2;
  margin-bottom: 1.25rem;
  color: var(--text-primary);
}

@media (max-width: 640px) {
  .not-found-headline {
    font-size: 1.85rem;
  }
}

.not-found-lead {
  font-size: 1.125rem;
  line-height: 1.7;
  color: var(--text-secondary);
  margin-bottom: 2.5rem;
}

.not-found-search-section {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 2.5rem;
}

.search-section-label {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
}

.search-input-group {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  position: relative;
}

@media (max-width: 640px) {
  .search-input-group {
    flex-direction: column;
    align-items: stretch;
  }
}

.search-icon {
  position: absolute;
  left: 1rem;
  color: var(--text-muted);
  pointer-events: none;
}

@media (max-width: 640px) {
  .search-icon {
    top: 0.85rem;
  }
}

.search-input-group input {
  flex: 1;
  padding: 0.85rem 1rem 0.85rem 2.85rem;
  font-size: 1rem;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  background-color: var(--bg-surface);
  color: var(--text-primary);
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.search-input-group input:focus {
  border-color: var(--accent-color);
  box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.12);
}

.search-submit-btn {
  padding: 0.85rem 1.5rem;
  font-size: 0.95rem;
  white-space: nowrap;
}

.navigation-options {
  border-top: 1px solid var(--border-light);
  padding-top: 2rem;
}

.navigation-heading {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  font-weight: 700;
  margin-bottom: 1.25rem;
  font-family: var(--font-sans);
}

.nav-cards-grid {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.nav-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.25rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  background-color: var(--bg-card);
  text-decoration: none !important;
  color: inherit;
  transition: all 0.15s ease;
}

.nav-card:hover {
  border-color: var(--gold-badge-border);
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
}

.nav-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 8px;
  background-color: var(--provenance-bg);
  border: 1px solid var(--provenance-border);
  color: var(--accent-color);
  flex-shrink: 0;
}

.nav-card-body {
  flex: 1;
  min-width: 0;
}

.nav-card-title {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.25rem;
}

.nav-card-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.4;
  margin: 0;
}

.nav-card-arrow {
  font-size: 1.25rem;
  color: var(--accent-color);
  font-weight: 700;
  padding-left: 0.5rem;
  transition: transform 0.15s ease;
}

.nav-card:hover .nav-card-arrow {
  transform: translateX(4px);
}
</style>
