---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import articlesData from '../data/articles.json';

// Group articles by year
const articlesByYear: Record<string, typeof articlesData> = {};

for (const art of articlesData) {
  const year = new Date(art.published_at).getFullYear().toString();
  if (!articlesByYear[year]) {
    articlesByYear[year] = [];
  }
  articlesByYear[year].push(art);
}

const sortedYears = Object.keys(articlesByYear).sort((a, b) => parseInt(b, 10) - parseInt(a, 10));
---

<BaseLayout
  title="Living Chronological Archive | Arun Kumar (Hindustan Times Patna)"
  description="Living chronological record of all dispatches authored by Arun Kumar for Hindustan Times Patna Bureau."
>
  <div class="container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 1.5rem; margin-bottom: 3rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: #16a34a;"></span>
        <span style="font-size: 0.85rem; font-weight: 700; color: #16a34a; text-transform: uppercase; letter-spacing: 0.05em;">
          Live & Historical Timeline Index
        </span>
      </div>
      <h1 style="font-size: 2.75rem; margin: 0.5rem 0 1rem;">
        Living Chronological Archive
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-secondary);">
        {articlesData.length} published dispatches continuously updated from Arun Kumar's active ongoing reporting for <em>Hindustan Times</em> (Patna Bureau).
      </p>

      {/* Year Jump Pills */}
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.5rem;">
        {sortedYears.map(year => (
          <a href={`#year-${year}`} class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;">
            {year} ({articlesByYear[year].length})
          </a>
        ))}
      </div>
    </div>

    {/* Year Groups */}
    <div style="display: flex; flex-direction: column; gap: 4rem;">
      {sortedYears.map(year => (
        <section id={`year-${year}`}>
          <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
            <h2 style="font-size: 2rem; color: var(--accent-color);">{year}</h2>
            <span style="font-size: 0.9rem; color: var(--text-muted);">
              ({articlesByYear[year].length} {articlesByYear[year].length === 1 ? 'dispatch' : 'dispatches'})
            </span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
            {articlesByYear[year].map(art => (
              <ArticleCard article={art} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
