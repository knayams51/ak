---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import articlesData from '../../data/articles.json';
import relatedContent from '../../data/related-content.json';

export async function getStaticPaths() {
  return articlesData.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const related = (relatedContent as Record<string, any>)[article.slug] || [];

// Render paragraphs
const cleanBody = article.body_markdown
  ? article.body_markdown.replace(/\r\n/g, '\n').replace(/^#\s+[^\n]+\n+/, '')
  : (article.summary || '');

const paragraphs = cleanBody ? cleanBody.split(/\n\s*\n/) : [];
---

<ArticleLayout article={article} related={related}>
  {paragraphs.map((p: string) => {
    const trimmed = p.trim();
    if (!trimmed) return null;
    const htmlFormatted = trimmed
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');
    return <p set:html={htmlFormatted} />;
  })}
</ArticleLayout>
