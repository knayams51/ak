---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SocialConnect from '../components/SocialConnect.astro';
import authorConfig from '../config/author.config.json';
import taxonomyConfig from '../config/taxonomy.config.json';
import articlesData from '../data/articles.json';

const latestArticles = articlesData.slice(0, 6);
const leadArticle = articlesData[0];
const secondaryArticles = articlesData.slice(1, 4);
---

<BaseLayout>
  {/* Hero / Editorial Banner */}
  <section style="background-color: var(--bg-surface); border-bottom: 1px solid var(--border-color); padding: 3.5rem 0 3rem;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr; max-width: 840px; margin: 0 auto; text-align: center;">
        <span style="font-size: 0.85rem; font-weight: 700; color: var(--accent-color); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;">
          The Official Living Journalistic Archive
        </span>
        <h1 style="font-size: 3rem; line-height: 1.15; margin-bottom: 1rem;">
          Documenting Contemporary Bihar
        </h1>
        <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.75rem;">
          Over two and a half decades of continuous, active reporting on Bihar politics, higher education reforms, Patna High Court jurisprudence, and state governance by <strong>Arun Kumar</strong>, Senior Assistant Editor at <em>Hindustan Times</em> (Patna Bureau).
        </p>

        <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/archive" class="btn btn-primary">
            Explore Living Archive ({articlesData.length} Dispatches)
          </a>
          <a href="/topics" class="btn btn-outline">
            Browse by Beat
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Lead Story & Highlights */}
  <section class="container" style="padding: 3.5rem 1.25rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid var(--border-color); padding-bottom: 0.75rem; margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem;">Latest Dispatches</h2>
      <a href="/archive" style="font-weight: 600; font-size: 0.9rem; color: var(--accent-color);">
        View living archive →
      </a>
    </div>

    {leadArticle && (
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
        <div class="card" style="padding: 2rem; background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-primary) 100%);">
          <span style="font-size: 0.75rem; font-weight: 800; color: var(--accent-color); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; display: block;">
            Featured Report • {leadArticle.topic?.title}
          </span>
          <h3 style="font-size: 1.8rem; line-height: 1.3; margin-bottom: 1rem;">
            <a href={`/articles/${leadArticle.slug}`} style="color: inherit; text-decoration: none;">
              {leadArticle.title}
            </a>
          </h3>
          <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
            {leadArticle.summary}
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border-light); padding-top: 1rem;">
            <span>By {leadArticle.byline} ({leadArticle.dateline})</span>
            <a href={`/articles/${leadArticle.slug}`} class="btn btn-primary" style="padding: 0.4rem 0.85rem; font-size: 0.8rem;">
              Read dispatch →
            </a>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          {secondaryArticles.map(art => (
            <div class="card" style="padding: 1.25rem;">
              <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted);">
                {new Date(art.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })} • {art.topic?.title}
              </span>
              <h4 style="font-size: 1.15rem; line-height: 1.35; margin: 0.4rem 0 0.5rem;">
                <a href={`/articles/${art.slug}`} style="color: inherit; text-decoration: none;">
                  {art.title}
                </a>
              </h4>
              <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5;">
                {art.summary}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Beat Breakdown */}
    <div style="margin-top: 4rem;">
      <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 0.75rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.75rem;">Editorial Beats</h2>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">
          Continuous structured reporting across key sectors of Bihar governance, education, and jurisprudence.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {taxonomyConfig.topics.map(topic => {
          const topicArticles = articlesData.filter(a => a.topic?.id === topic.id);
          return (
            <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <h3 style="font-size: 1.25rem; margin-bottom: 0.6rem;">
                  <a href={`/topics/${topic.slug}`} style="color: inherit; text-decoration: none;">
                    {topic.title}
                  </a>
                </h3>
                <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem;">
                  {topic.description}
                </p>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-light); padding-top: 0.75rem; font-size: 0.85rem;">
                <span style="color: var(--text-muted); font-weight: 600;">
                  {topicArticles.length} {topicArticles.length === 1 ? 'dispatch' : 'dispatches'}
                </span>
                <a href={`/topics/${topic.slug}`} style="font-weight: 600; color: var(--accent-color);">
                  Explore beat →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
