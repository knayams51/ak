---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SocialConnect from '../components/SocialConnect.astro';
import AuthorPortrait from '../components/AuthorPortrait.astro';
import authorConfig from '../config/author.config.json';
import taxonomyConfig from '../config/taxonomy.config.json';
import articlesData from '../data/articles.json';

const leadArticle = articlesData[0];
const secondaryArticles = articlesData.slice(1, 4);
---

<BaseLayout>
  {/* Hero / Editorial Banner */}
  <section class="hero-section">
    <div class="container">
      <div class="hero-layout">
        {/* Mobile Portrait Vignette */}
        <div class="mobile-portrait-wrap">
          <AuthorPortrait variant="circle" size={92} />
        </div>

        <div class="hero-main-content">
          {/* Laureate Eyebrow Badge */}
          <div class="laureate-eyebrow-wrap">
            <span class="laureate-gold-badge">
              <svg class="award-star-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              K.C. Kulish International Journalism Award Laureate
            </span>
            <span class="laureate-sub-badge">Keshav Bhatt Award • LDM Fellow</span>
          </div>

          {/* Grand Dominant Front Page Headline */}
          <h1 class="hero-title">
            Three Decades of <span class="highlight-gold">Award-Winning Journalism</span> Documenting Contemporary Bihar
          </h1>

          <p class="hero-desc">
            The official living digital archive of <strong>Arun Kumar</strong>, Associate Editor at <em>Hindustan Times</em> (Patna Bureau). Chronicling Bihar's political transitions, higher education reforms, Patna High Court jurisprudence, and state governance with uncompromising investigative fidelity across 35+ years.
          </p>

          <div class="hero-cta-row">
            <a href="/archive" class="btn btn-primary grand-cta-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              Explore Living Archive ({articlesData.length} Dispatches)
            </a>
            <a href="/topics" class="btn btn-outline grand-cta-btn">
              Browse Bihar Beats →
            </a>
          </div>

          {/* Connect Bar */}
          <div class="hero-connect-row">
            <span class="hero-connect-label">Connect with Arun Kumar:</span>
            <SocialConnect />
          </div>
        </div>

        {/* Desktop Framed Poster Card */}
        <div class="desktop-portrait-wrap">
          <AuthorPortrait variant="hero" />
        </div>
      </div>
    </div>
  </section>

  {/* Grand Laureate Accolades Strip */}
  <section class="accolades-strip-section">
    <div class="container">
      <div class="accolades-grid">
        <div class="accolade-card">
          <div class="accolade-icon-wrap">
            <span class="accolade-trophy">🏆</span>
          </div>
          <div class="accolade-info">
            <strong class="accolade-title">K.C. Kulish Award (2014)</strong>
            <span class="accolade-sub">International Award for Print Investigative Excellence</span>
          </div>
        </div>

        <div class="accolade-card">
          <div class="accolade-icon-wrap">
            <span class="accolade-trophy">🏅</span>
          </div>
          <div class="accolade-info">
            <strong class="accolade-title">Keshav Bhatt Journalism Award</strong>
            <span class="accolade-sub">Honoring Outstanding Bihar Investigative Reporting</span>
          </div>
        </div>

        <div class="accolade-card">
          <div class="accolade-icon-wrap">
            <span class="accolade-trophy">🎖️</span>
          </div>
          <div class="accolade-info">
            <strong class="accolade-title">LDM Fellowship</strong>
            <span class="accolade-sub">Public Policy, Governance & Institutional Reforms Fellow</span>
          </div>
        </div>

        <div class="accolade-card">
          <div class="accolade-icon-wrap">
            <span class="accolade-trophy">🏛️</span>
          </div>
          <div class="accolade-info">
            <strong class="accolade-title">35+ Years Active Beat</strong>
            <span class="accolade-sub">Associate Editor, Hindustan Times (Patna Bureau)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Lead Story & Front Page Dispatches */}
  <section class="container dispatches-section">
    <div class="section-header">
      <div>
        <span class="section-badge-gold">★ Front Page Broadsheet</span>
        <h2 class="section-heading">Featured Lead Dispatch</h2>
      </div>
      <a href="/archive" class="section-sublink">
        View complete archive ({articlesData.length} dispatches) →
      </a>
    </div>

    {/* Featured Lead Dispatch Card (Grand Broadsheet Style) */}
    {leadArticle && (
      <div class="card lead-card">
        <div class="lead-meta-top">
          <span class="lead-badge">
            ★ Featured Report • {leadArticle.topic?.title}
          </span>
          <div class="lead-meta-right">
            <span class="lead-date">
              {new Date(leadArticle.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          </div>
        </div>
        <h3 class="lead-title">
          <a href={`/articles/${leadArticle.slug}`} style="color: inherit; text-decoration: none;">
            {leadArticle.title}
          </a>
        </h3>
        <p class="lead-summary">
          {leadArticle.summary}
        </p>
        <div class="lead-footer">
          <span class="lead-byline-text">
            By <strong>{leadArticle.byline}</strong> ({leadArticle.dateline}) • {leadArticle.word_count || 450} words • <em>Hindustan Times</em>
          </span>
          <a href={`/articles/${leadArticle.slug}`} class="btn btn-primary lead-btn">
            Read full dispatch →
          </a>
        </div>
      </div>
    )}

    {/* Secondary Stories Grid */}
    <div class="dispatches-grid">
      {secondaryArticles.map(art => (
        <ArticleCard article={art} />
      ))}
    </div>

    {/* Documenting Contemporary Bihar: Historical & Living Monograph Hub */}
    <div class="bihar-chronicle-section">
      <div class="chronicle-header">
        <span class="chronicle-badge">THE LIVING HISTORICAL RECORD</span>
        <h2 class="chronicle-heading">Documenting Contemporary Bihar: Four Decades of Grounded Journalism</h2>
        <p class="chronicle-desc">
          Through shifting coalition dynamics, university governance battles, teacher recruitment movements, and landmark Patna High Court orders, Arun Kumar's dispatches constitute the definitive primary record of Bihar's socio-political transformation.
        </p>
      </div>

      <div class="chronicle-pillars-grid">
        <div class="card chronicle-pillar-card">
          <div class="pillar-icon-box">🏛️</div>
          <h3 class="pillar-title">Political Transitions & Coalition Eras</h3>
          <p class="pillar-desc">
            Firsthand reporting on Bihar's evolving political equations, coalition realignments, assembly elections, and state cabinet governance.
          </p>
          <a href="/topics/politics-elections-governance" class="pillar-link">
            Explore Politics →
          </a>
        </div>

        <div class="card chronicle-pillar-card">
          <div class="pillar-icon-box">🎓</div>
          <h3 class="pillar-title">Higher Education & BPSC Reforms</h3>
          <p class="pillar-desc">
            Investigative tracking of university autonomy battles, teacher recruitment examinations (TRE / BPSC), and education policy shifts.
          </p>
          <a href="/topics/higher-education-reforms" class="pillar-link">
            Explore Education →
          </a>
        </div>

        <div class="card chronicle-pillar-card">
          <div class="pillar-icon-box">⚖️</div>
          <h3 class="pillar-title">Patna High Court Jurisprudence</h3>
          <p class="pillar-desc">
            Authoritative reporting on landmark constitutional orders, judicial oversight of executive policy, PILs, and legal accountability.
          </p>
          <a href="/topics/judiciary-law-patna-high-court" class="pillar-link">
            Explore Judiciary →
          </a>
        </div>

        <div class="card chronicle-pillar-card">
          <div class="pillar-icon-box">🔍</div>
          <h3 class="pillar-title">Vigilance & State Governance</h3>
          <p class="pillar-desc">
            Investigative accounts of public finance, anti-corruption vigilance crackdowns, flood crisis response, and administrative delivery.
          </p>
          <a href="/topics/state-administration-vigilance" class="pillar-link">
            Explore Governance →
          </a>
        </div>
      </div>
    </div>

    {/* Direct Dispatches & Social Community Connect Card */}
    <div class="card community-connect-card">
      <div class="community-card-grid">
        <div class="community-card-info">
          <div class="community-badge-row">
            <span class="community-pill-badge">
              <span class="live-pulse-dot"></span> Active Dispatches
            </span>
            <span class="community-tag">Associate Editor • HT Patna</span>
          </div>
          <h3 class="community-card-title">
            Connect Directly with Arun Kumar
          </h3>
          <p class="community-card-desc">
            Receive direct updates, breaking political dispatches, Patna High Court developments, and university reform reports across your preferred channels.
          </p>
          <div class="community-features-list">
            <span>✓ Daily Updated Living Archive</span>
            <span>✓ Non-Negotiable Editorial Fidelity</span>
            <span>✓ Source-Verified Archival Records</span>
          </div>
        </div>

        <div class="community-actions-column">
          <a href={authorConfig.social_links.whatsapp?.url || 'https://api.whatsapp.com/send?text=Connecting%20with%20Arun%20Kumar%20(HT%20Patna%20Bureau)'} target="_blank" rel="noopener noreferrer" class="community-action-btn whatsapp-action-btn">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.301-.15-1.781-.878-2.057-.978-.276-.1-.476-.15-.677.15-.201.301-.778.978-.953 1.178-.175.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.675-2.085-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.151-.175.201-.301.301-.501.101-.2.05-.376-.025-.526-.075-.15-.677-1.631-.928-2.235-.244-.588-.492-.508-.677-.518-.175-.008-.376-.01-.577-.01-.201 0-.527.075-.802.376-.276.301-1.054 1.03-1.054 2.513 0 1.482 1.079 2.913 1.23 3.114.15.2 2.124 3.243 5.145 4.549.719.311 1.281.497 1.719.636.723.23 1.381.197 1.901.12.58-.087 1.781-.728 2.032-1.431.251-.703.251-1.305.176-1.431-.075-.126-.276-.201-.577-.351zm-5.467 7.618c-2.03 0-3.92-.619-5.5-1.685l-.394-.265-4.106 1.077 1.096-4.004-.258-.411C2.087 15.111 1.4 13.125 1.4 11c0-5.845 4.755-10.6 10.605-10.6 5.845 0 10.595 4.755 10.595 10.6 0 5.845-4.75 10.6-10.595 10.6zm0-23c-6.848 0-12.4 5.552-12.4 12.4 0 2.19.57 4.328 1.656 6.208l-1.761 6.432 6.58-1.725c1.815 1.018 3.882 1.553 5.925 1.553 6.848 0 12.4-5.552 12.4-12.4 0-6.848-5.552-12.4-12.4-12.4z"/>
            </svg>
            <div class="action-btn-text">
              <strong>Connect on WhatsApp</strong>
              <span>Direct messages & updates</span>
            </div>
          </a>

          <a href={authorConfig.social_links.facebook?.url || 'https://www.facebook.com/share/1B8w1Bv52r/'} target="_blank" rel="noopener noreferrer" class="community-action-btn facebook-action-btn">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <div class="action-btn-text">
              <strong>Connect on Facebook</strong>
              <span>Author updates & dispatches</span>
            </div>
          </a>

          <div class="secondary-actions-row">
            <a href={authorConfig.social_links.twitter?.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="flex: 1; font-size: 0.85rem; padding: 0.45rem 0.75rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              Follow @ArunkrHt
            </a>
            <a href="/rss.xml" class="btn btn-outline" style="flex: 1; font-size: 0.85rem; padding: 0.45rem 0.75rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
              RSS Feed
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Beat Breakdown */}
    <div class="beats-section-wrap">
      <div class="section-header">
        <div>
          <h2 class="section-heading">Editorial Beats</h2>
          <p class="section-subdesc">
            Continuous structured reporting across key sectors of Bihar governance, education, and jurisprudence.
          </p>
        </div>
      </div>

      <div class="beats-grid">
        {taxonomyConfig.topics.map(topic => {
          const topicArticles = articlesData.filter(a => a.topic?.id === topic.id);
          return (
            <div class="card beat-card">
              <div>
                <h3 class="beat-title">
                  <a href={`/topics/${topic.slug}`} style="color: inherit; text-decoration: none;">
                    {topic.title}
                  </a>
                </h3>
                <p class="beat-desc">
                  {topic.description}
                </p>
              </div>
              <div class="beat-footer">
                <span class="beat-count">
                  {topicArticles.length} {topicArticles.length === 1 ? 'dispatch' : 'dispatches'}
                </span>
                <a href={`/topics/${topic.slug}`} class="beat-link">
                  Explore beat →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 3.5rem 0 2.75rem;
    position: relative;
  }

  .hero-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3.25rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .mobile-portrait-wrap {
    display: none;
  }

  .desktop-portrait-wrap {
    display: block;
    flex-shrink: 0;
  }

  .hero-main-content {
    flex: 1;
    min-width: 0;
  }

  .laureate-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .laureate-gold-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--gold-badge-bg);
    border: 1px solid var(--gold-badge-border);
    color: var(--gold-accent);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
  }

  .award-star-icon {
    color: var(--gold-border);
    flex-shrink: 0;
  }

  .laureate-sub-badge {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.03em;
  }

  .hero-title {
    font-size: clamp(2rem, 5.5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .highlight-gold {
    color: var(--gold-accent);
    position: relative;
  }

  .hero-desc {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .grand-cta-btn {
    padding: 0.65rem 1.25rem;
    font-size: 0.92rem;
  }

  .hero-connect-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--border-light);
    flex-wrap: wrap;
  }

  .hero-connect-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Accolades Showcase Strip */
  .accolades-strip-section {
    background: var(--gold-gradient);
    border-bottom: 1px solid var(--gold-badge-border);
    padding: 1.5rem 0;
  }

  .accolades-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .accolade-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--gold-badge-border);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .accolade-icon-wrap {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .accolade-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .accolade-title {
    font-size: 0.88rem;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .accolade-sub {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  /* Dispatches Section */
  .dispatches-section {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.85rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .section-badge-gold {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--gold-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.25rem;
  }

  .section-heading {
    font-size: clamp(1.45rem, 4vw, 1.85rem);
    margin: 0;
  }

  .section-sublink {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--accent-color);
    text-decoration: none;
  }

  .section-subdesc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  /* Grand Broadsheet Lead Card */
  .lead-card {
    padding: 2rem 2.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-left: 6px solid var(--gold-accent);
    margin-bottom: 2rem;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }

  .lead-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lead-badge {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--gold-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lead-meta-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }


  .lead-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .lead-title {
    font-size: clamp(1.4rem, 4.2vw, 1.95rem);
    line-height: 1.28;
    margin-bottom: 0.85rem;
  }

  .lead-summary {
    font-size: clamp(0.98rem, 2.5vw, 1.1rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.35rem;
  }

  .lead-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-light);
    padding-top: 0.85rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lead-btn {
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
  }

  .dispatches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.35rem;
    margin-bottom: 4rem;
  }

  /* Documenting Contemporary Bihar: Chronicle Section */
  .bihar-chronicle-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--gold-accent);
    border-radius: 10px;
    padding: 2.5rem 1.75rem;
    margin: 3.5rem 0;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
  }

  .chronicle-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2.25rem;
  }

  .chronicle-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--gold-accent);
    background: var(--gold-badge-bg);
    border: 1px solid var(--gold-badge-border);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .chronicle-heading {
    font-size: clamp(1.45rem, 3.8vw, 2rem);
    line-height: 1.25;
    margin-bottom: 0.85rem;
  }

  .chronicle-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .chronicle-pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .chronicle-pillar-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    padding: 1.25rem 1.1rem;
    border-radius: 8px;
