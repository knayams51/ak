---
import BaseLayout from '../../layouts/BaseLayout.astro';
import taxonomyConfig from '../../config/taxonomy.config.json';
import articlesData from '../../data/articles.json';
---

<BaseLayout
  title="Editorial Beats | Arun Kumar Journalism"
  description="Explore Arun Kumar's journalistic coverage categorized across 5 canonical Bihar reporting beats."
>
  <div class="container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 1.5rem; margin-bottom: 3rem;">
      <span style="font-size: 0.85rem; font-weight: 700; color: var(--accent-color); text-transform: uppercase; letter-spacing: 0.05em;">
        Beat Explorer
      </span>
      <h1 style="font-size: 2.75rem; margin: 0.5rem 0 1rem;">
        Editorial Beats
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-secondary);">
        Structured reporting across the legislative, judicial, educational, administrative, and social pillars of Bihar.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem;">
      {taxonomyConfig.topics.map(topic => {
        const topicArticles = articlesData.filter(a => a.topic?.id === topic.id);
        return (
          <div class="card" style="padding: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
              <div>
                <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">
                  <a href={`/topics/${topic.slug}`} style="color: inherit; text-decoration: none;">
                    {topic.title}
                  </a>
                </h2>
                <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.5;">
                  {topic.description}
                </p>
              </div>
              <a href={`/topics/${topic.slug}`} class="btn btn-primary" style="padding: 0.45rem 1rem; font-size: 0.85rem; white-space: nowrap;">
                View All {topicArticles.length} Dispatches →
              </a>
            </div>

            {/* Subtopics (Clickable) */}
            {topic.subtopics && topic.subtopics.length > 0 && (
              <div style="border-top: 1px solid var(--border-light); padding-top: 1.25rem; margin-top: 1rem;">
                <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.75rem; display: block;">
                  Subtopics in this Beat (Click to view linked dispatches):
                </span>
                <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                  {topic.subtopics.map(sub => {
                    const subCount = topicArticles.filter(a => a.subtopic?.id === sub.id || a.subtopic?.slug === sub.slug).length;
                    return (
                      <a
                        href={`/topics/${topic.slug}?subtopic=${sub.slug}`}
                        class="btn btn-outline subtopic-btn"
                        style="padding: 0.35rem 0.8rem; font-size: 0.85rem; border-radius: 20px; text-decoration: none;"
                      >
                        {sub.title}
                        <span style="background: var(--border-color); color: var(--text-primary); font-size: 0.75rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 10px; margin-left: 0.35rem;">
                          {subCount}
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .subtopic-btn:hover {
    border-color: var(--accent-color) !important;
    color: var(--accent-color) !important;
    background-color: var(--bg-surface) !important;
    transform: translateY(-1px);
  }
</style>
